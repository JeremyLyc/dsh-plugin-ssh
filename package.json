{
  "name": "dsh-plugin-ssh",
  "version": "0.4.0",
  "description": "Workspace-scoped SSH for DeepSeek Harness: a session can only reach the server its workspace is bound to; agent tools plus a sidebar panel, server file browser, directory picker and password prompt",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./docs/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/tools.js",
    "lib/client.js",
    "lib/config.js",
    "lib/ssh.js",
    "server.mjs",
    "docs"
  ],
  "scripts": {
    "test": "node test/host-api.mjs",
    "test:mcp": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremyLyc/dsh-plugin-ssh.git"
  },
  "homepage": "https://github.com/JeremyLyc/dsh-plugin-ssh#readme",
  "bugs": {
    "url": "https://github.com/JeremyLyc/dsh-plugin-ssh/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "ssh",
    "sftp",
    "mcp",
    "remote-workspace",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  }
}
